{
  "name": "fiavaion-dictate",
  "version": "1.0.0",
  "description": "Voice dictation with AI correction",
  "author": "Fiavaion",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "python evals/smoke-test.py",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac"
  },
  "build": {
    "appId": "io.fiavaion.dictate",
    "productName": "FiavaionDictate",
    "copyright": "Fiavaion",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "js/**/*",
      "css/**/*",
      "!**/__pycache__/**",
      "!**/node_modules/.cache/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "FiavaionDictate"
    }
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.5",
      "@electron/asar": { "minimatch": "^3.1.5" },
      "dir-compare": { "minimatch": "^3.1.5" },
      "ejs": { "minimatch": "^5.1.9" }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=9.0.0"
  }
}
